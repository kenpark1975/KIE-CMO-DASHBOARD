# ==========================================
# 경인전자 CMO 대시보드 — API 키 설정
# ==========================================
# 이 파일을 복사해서 .env 로 저장 후 값 입력
# .env 파일은 절대 Git에 커밋하지 말 것

# ------------------------------------------
# Google Sheets
# ------------------------------------------
GOOGLE_SHEET_ID=                        # 구글 시트 ID (URL에서 복사)
GOOGLE_CREDENTIALS_PATH=config/google_credentials.json

# ------------------------------------------
# 메타 광고 (Meta Business API)
# ------------------------------------------
META_ACCESS_TOKEN=                       # 장기 액세스 토큰
META_AD_ACCOUNT_ID_BC=                   # 브리즈케어 광고계정 ID
META_AD_ACCOUNT_ID_HK=                   # 헬스키친 광고계정 ID
META_AD_ACCOUNT_ID_BD=                   # 뷰티디바이스 광고계정 ID

# ------------------------------------------
# 구글 광고 (Google Ads API)
# ------------------------------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID_BC=              # 브리즈케어
GOOGLE_ADS_CUSTOMER_ID_HK=              # 헬스키친
GOOGLE_ADS_CUSTOMER_ID_BD=              # 뷰티디바이스

# ------------------------------------------
# 네이버 검색광고 API
# ------------------------------------------
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=

# ------------------------------------------
# ONEWMS API
# ------------------------------------------
ONEWMS_API_KEY=
ONEWMS_API_SECRET=
ONEWMS_BASE_URL=https://api.onewms.co.kr   # 실제 엔드포인트 확인 필요

# ------------------------------------------
# 인스타그램 Graph API
# ------------------------------------------
INSTAGRAM_ACCESS_TOKEN_BC=              # 브리즈케어 계정
INSTAGRAM_ACCESS_TOKEN_HK=              # 헬스키친 계정
INSTAGRAM_ACCESS_TOKEN_BD=              # 뷰티디바이스 계정
INSTAGRAM_BUSINESS_ID_BC=
INSTAGRAM_BUSINESS_ID_HK=
INSTAGRAM_BUSINESS_ID_BD=

# ------------------------------------------
# 네이버 데이터랩 API
# ------------------------------------------
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# ------------------------------------------
# 설정
# ------------------------------------------
COLLECT_DAYS_BACK=7                     # 수집 기간 (일)
LOG_LEVEL=info                          # debug | info | error
